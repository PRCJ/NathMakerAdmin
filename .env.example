# Copy this to .env and fill in your values
# (never commit the actual .env file)

# PostgreSQL connection string (get from Neon.tech or any PostgreSQL host)
DATABASE_URL=postgresql://user:password@host/dbname

# Public site origin (used for CORS)
FRONTEND_URL=https://nathmakers.com

# Required. The app will not start without this.
ADMIN_PASSWORD=

# Set automatically when you create a public Blob store on the Vercel project
# (Storage tab → Create Database → Blob → Public)
BLOB_READ_WRITE_TOKEN=

# Google AI Studio key for studio-style jewellery photos (Gemini image model)
GEMINI_API_KEY=

# Optional. Default is gemini-3.1-flash-image (Nano Banana 2)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional free AI Horde key from https://aihorde.net/register (faster queue).
# Anonymous works without this, but can be slow.
# AIHORDE_API_KEY=

# Serve /docs and /openapi.json (never enable in production)
# ENABLE_DOCS=1

# Set to any value to allow all CORS origins (ignored when VERCEL_ENV=production)
# ALLOW_ALL_ORIGINS=1
